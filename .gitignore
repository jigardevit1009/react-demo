# ==========================================
# Monorepo Root .gitignore (Frontend & Backend)
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Production Build Outputs
dist/
dist-ssr/
build/
**/dist/
**/dist-ssr/
**/build/

# Environment Variables & Secrets (Keep .env.example safe)
.env
.env.*
*.env
*.env.local
*.env.production
backend/.env
frontend/.env
!.env.example
!**/.env.example

# Hosting & Cloud provider temporary artifacts
.vercel/
.render/

# Prisma Engines, SQLite & Temporary Files
*.sqlite
*.sqlite3
*.db
**/prisma/query_engine*
*.tmp*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
